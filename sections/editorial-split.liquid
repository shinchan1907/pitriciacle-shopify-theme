{%- comment -%} Pitriciacle · Editorial split — image and text, reversible, toned grounds {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .es__inner { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  #shopify-section-{{ section.id }} .es__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 4 / 5; }
  #shopify-section-{{ section.id }} .es__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .es__media[data-parallax-media] img { height: 122%; margin-top: -11%; transition: none; }
  #shopify-section-{{ section.id }} .es__media:hover img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .es__media[data-parallax-media]:hover img { transform: none; }
  #shopify-section-{{ section.id }} .es__rule { width: 3rem; height: 1px; background: var(--pt-champagne); margin: 1.5rem 0 0; }
  #shopify-section-{{ section.id }} .es__text .pt-h2 { margin-top: 1rem; }
  #shopify-section-{{ section.id }} .es__body { margin-top: 1.25rem; }
  #shopify-section-{{ section.id }} .es__cta { margin-top: 2rem; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .es__inner { grid-template-columns: 1fr 1fr; gap: 4rem; }
    #shopify-section-{{ section.id }} .es--reversed .es__media { order: 2; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .es__inner { gap: 5.5rem; }
    #shopify-section-{{ section.id }} .es--sticky .es__inner { align-items: start; }
    #shopify-section-{{ section.id }} .es--sticky .es__text {
      position: sticky;
      top: calc(var(--pt-header-h) + 3rem);
    }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'sand' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="es__inner {% if section.settings.reverse %}es--reversed{% endif %}{% if section.settings.sticky_text %} es--sticky{% endif %}">
      <div class="es__media pt-reveal"{% if section.settings.parallax %} data-parallax-media{% endif %}>
        {%- if section.settings.image -%}
          <img
            {% if section.settings.parallax %}data-parallax="0.1"{% endif %}
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            decoding="async">
        {%- else -%}
          <img
            src="{{ 'placeholder-hero.jpg' | asset_url }}"
            alt="{{ section.settings.heading | escape | default: 'Pitriciacle atelier' }}"
            loading="lazy"
            decoding="async">
        {%- endif -%}
      </div>
      <div class="es__text pt-reveal">
        {%- if section.settings.kicker != blank -%}
          <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="es__rule" aria-hidden="true"></div>
        {%- if section.settings.text != blank -%}
          <div class="pt-body es__body">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="es__cta">
            <a href="{{ section.settings.cta_link | default: '/pages/heritage' }}" class="pt-btn--quiet">{{ section.settings.cta_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, to be kept"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Pitriciacle piece begins in a small Indian workshop \u2014 not a factory line. Wood is seasoned, brass is beaten by hand, and mirrors are cut to sit inside arches the way they have for centuries.</p><p>We work in small batches with artisan clusters across Rajasthan, Uttar Pradesh and West Bengal, because some things cannot be hurried without losing their soul.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Read our heritage"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link",
      "default": "/pages/heritage"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse layout (text left, image right)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Slow parallax drift on image",
      "default": false,
      "info": "Desktop only; disabled automatically on mobile and for reduced-motion."
    },
    {
      "type": "checkbox",
      "id": "sticky_text",
      "label": "Sticky text column on desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Editorial split"
    }
  ]
}
{% endschema %}
