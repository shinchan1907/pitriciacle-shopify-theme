{%- comment -%} Pitriciacle · Heritage timeline — vertical timeline of eras {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .htl__head { text-align: center; max-width: 62ch; margin: 0 auto 3.5rem; }
  #shopify-section-{{ section.id }} .htl__list { list-style: none; margin: 0 auto; padding: 0; max-width: 44rem; border-left: 1px solid rgba(138,129,120,0.4); }
  #shopify-section-{{ section.id }} .htl__era { position: relative; padding: 0 0 3rem 2.5rem; }
  #shopify-section-{{ section.id }} .htl__era:last-child { padding-bottom: 0; }
  #shopify-section-{{ section.id }} .htl__era::before { content: ""; position: absolute; left: -5px; top: 0.45rem; width: 9px; height: 9px; border-radius: 50%; background: var(--pt-champagne); box-shadow: 0 0 0 5px var(--pt-porcelain), 0 0 0 6px rgba(201,169,106,0.45); }
  #shopify-section-{{ section.id }} .htl__year { font-family: var(--pt-sans); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--pt-slate); margin: 0 0 0.6rem; }
  #shopify-section-{{ section.id }} .htl__title { margin: 0 0 0.75rem; }
  #shopify-section-{{ section.id }} .htl__text { margin: 0; max-width: 52ch; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .htl__era { padding-left: 3.5rem; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="htl__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="htl__list">
        {%- for block in section.blocks -%}
          <li class="htl__era pt-reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.year != blank -%}
              <p class="htl__year">{{ block.settings.year | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pt-h3 htl__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="pt-body htl__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Heritage timeline",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A lineage of making"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "era",
      "name": "Era",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year / era",
          "default": "c. 1600"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The arch and the mirror"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "In the courts of Rajasthan, artisans set looking-glass into cusped arches and jharokha windows, so that light itself became ornament."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heritage timeline",
      "blocks": [
        {
          "type": "era",
          "settings": {
            "year": "c. 1600",
            "title": "The arch and the mirror",
            "text": "In the courts of Rajasthan, artisans set looking-glass into cusped arches and jharokha windows, so that light itself became ornament."
          }
        },
        {
          "type": "era",
          "settings": {
            "year": "c. 1800",
            "title": "Brass, beaten by hand",
            "text": "In the metalworking quarters of Moradabad, kansa and peetal were hammered into vessels for ritual and daily ceremony \u2014 each dent a signature."
          }
        },
        {
          "type": "era",
          "settings": {
            "year": "Today",
            "title": "The atelier continues",
            "text": "Pitriciacle works with artisan clusters across India to carry these crafts into contemporary homes \u2014 the same hands, the same patience, made for the way we live now."
          }
        }
      ]
    }
  ]
}
{% endschema %}
