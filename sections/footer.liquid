<footer class="pt-footer pt-scheme--{{ section.settings.color_scheme | default: 'ink' }}">
  <div class="pt-container">
    <div class="pt-footer__mega" aria-hidden="true"><span>Pitriciacle</span></div>
  </div>
  <hr class="pt-footer__rule">
  <div class="pt-container">
    <div class="pt-footer__top">
      <div>
        <p class="pt-footer__brand">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="160" height="44" loading="lazy">
          {%- else -%}
            Pitriciacle
          {%- endif -%}
        </p>
        <p class="pt-footer__blurb pt-body">
          Heirlooms for the modern Indian home — hand-carved mirrors, brass and copper objects, woven rugs and light, made slowly by master artisans.
        </p>
        <div class="pt-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="pt-icon-btn" aria-label="{{ 'general.footer.instagram' | t }}" target="_blank" rel="noopener">{% render 'icons', icon: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="pt-icon-btn" aria-label="{{ 'general.footer.pinterest' | t }}" target="_blank" rel="noopener">{% render 'icons', icon: 'pinterest' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="pt-footer__heading">{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.menu != blank -%}
                <ul class="pt-footer__menu">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="pt-footer__heading">{{ block.settings.heading | escape }}</h3>
              <div class="pt-footer__contact">{{ block.settings.text }}</div>
            </div>
          {%- when 'contact' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="pt-footer__heading">{{ block.settings.heading | escape }}</h3>
              <div class="pt-footer__contact">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div>
          <h3 class="pt-footer__heading">{{ 'newsletter.footer_heading' | t }}</h3>
          <p class="pt-footer__contact">{{ 'newsletter.footer_text' | t }}</p>
          {%- form 'customer', class: 'pt-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="pt-visually-hidden" for="FooterNewsletter-email">{{ 'newsletter.label' | t }}</label>
            <input
              type="email"
              id="FooterNewsletter-email"
              name="contact[email]"
              class="pt-input"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              autocomplete="email">
            <button type="submit" class="pt-btn" aria-label="{{ 'newsletter.button' | t }}">{% render 'icons', icon: 'arrow-right' %}</button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pt-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright | escape }}</p>
      <div class="pt-footer__meta">
        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'FooterCountryForm', class: 'pt-localization pt-localization--footer' -%}
            <label class="pt-visually-hidden" for="FooterCountrySelect">{{ 'general.localization.country_label' | t }}</label>
            <select id="FooterCountrySelect" name="country_code" class="pt-localization__select" data-country-select>
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                  {{ country.name }} · {{ country.currency.iso_code }} {{ country.currency.symbol }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
        <div class="pt-payment-icons" aria-label="{{ 'general.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'pt-payment-icon' }}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "porcelain", "label": "Porcelain" },
        { "value": "sand", "label": "Sand" },
        { "value": "sage", "label": "Sage" },
        { "value": "blush", "label": "Blush" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "checkbox", "id": "show_country_selector", "label": "Show country / currency selector", "default": true, "info": "Requires Shopify Markets with more than one market enabled." },
    { "type": "text", "id": "copyright", "label": "Copyright line (after © year + store name)", "default": "All rights reserved. Crafted with patience in India." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our promise" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece is made by hand, finished with natural materials, and built to be handed down.</p>" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Atelier" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>care@pitriciacle.in<br>Monday – Saturday, 10am – 6pm IST</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "contact" },
      { "type": "text" }
    ]
  }
}
{% endschema %}
