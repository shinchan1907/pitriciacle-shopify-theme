{%- comment -%} Pitriciacle · Testimonials — elegant serif quotes {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .tst__head { text-align: center; max-width: 62ch; margin: 0 auto 3.5rem; }
  #shopify-section-{{ section.id }} .tst__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  #shopify-section-{{ section.id }} .tst__quote { margin: 0; text-align: center; }
  #shopify-section-{{ section.id }} .tst__mark { display: block; font-family: var(--pt-serif); font-size: 3.5rem; line-height: 0.6; color: var(--pt-champagne); margin-bottom: 1.25rem; }
  #shopify-section-{{ section.id }} .tst__text { font-family: var(--pt-serif); font-size: 1.45rem; font-style: italic; font-weight: 400; line-height: 1.5; color: var(--pt-ink); margin: 0 0 1.5rem; }
  #shopify-section-{{ section.id }} .tst__rule { width: 2.5rem; height: 1px; background: var(--pt-champagne); margin: 0 auto 1rem; }
  #shopify-section-{{ section.id }} .tst__author { margin: 0; }
  #shopify-section-{{ section.id }} .tst__location { margin: 0.25rem 0 0; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .tst__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    #shopify-section-{{ section.id }} .tst__text { font-size: 1.35rem; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'sand' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="tst__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tst__grid">
        {%- for block in section.blocks -%}
          <figure class="tst__quote pt-reveal" {{ block.shopify_attributes }}>
            <span class="tst__mark" aria-hidden="true">&ldquo;</span>
            {%- if block.settings.quote != blank -%}
              <blockquote class="tst__text">{{ block.settings.quote | escape }}</blockquote>
            {%- endif -%}
            <div class="tst__rule" aria-hidden="true"></div>
            <figcaption>
              {%- if block.settings.author != blank -%}
                <p class="pt-kicker tst__author">{{ block.settings.author | escape }}</p>
              {%- endif -%}
              {%- if block.settings.location != blank -%}
                <p class="pt-muted tst__location">{{ block.settings.location | escape }}</p>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Kind words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Adored in beautiful homes"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The mirror changed the whole temper of our living room \u2014 morning light moves across it like water."
        },
        {
          "type": "text",
          "id": "author",
          "label": "First name",
          "default": "Aisha"
        },
        {
          "type": "text",
          "id": "location",
          "label": "City",
          "default": "Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "The Rajwada mirror changed the whole temper of our living room \u2014 morning light moves across it like water.",
            "author": "Aisha",
            "location": "Mumbai"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "You can feel the hand in it. The urli pair sits by our entrance, and every guest asks where it is from.",
            "author": "Rohan",
            "location": "Bengaluru"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "Ordered the Gulnar rug for our reading corner. It arrived beautifully packed, and the weave is even finer in person.",
            "author": "Meera",
            "location": "New Delhi"
          }
        }
      ]
    }
  ]
}
{% endschema %}
