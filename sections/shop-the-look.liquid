{%- comment -%} Pitriciacle · Shop the look — lookbook image with pulsing product hotspots {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .stl__head { text-align: center; max-width: 72rem; margin: 0 auto 4.8rem; }
  #shopify-section-{{ section.id }} .stl__head .pt-h2 { margin-top: 1.2rem; }
  #shopify-section-{{ section.id }} .stl__stage { position: relative; max-width: 120rem; margin: 0 auto; }
  #shopify-section-{{ section.id }} .stl__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 4 / 5; }
  #shopify-section-{{ section.id }} .stl__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .stl__spot { position: absolute; transform: translate(-50%, -50%); z-index: 3; }
  #shopify-section-{{ section.id }} .stl__hotspot {
    width: 4.4rem; height: 4.4rem;
    display: grid; place-items: center;
    border-radius: 50%;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .stl__dot {
    width: 1.4rem; height: 1.4rem;
    border-radius: 50%;
    background: var(--pt-champagne);
    box-shadow: 0 0 0 5px rgba(250, 248, 244, 0.9), 0 2px 10px rgba(24, 19, 14, 0.25);
    transition: transform 0.35s var(--pt-ease);
  }
  #shopify-section-{{ section.id }} .stl__hotspot:hover .stl__dot { transform: scale(1.25); }
  #shopify-section-{{ section.id }} .stl__hotspot .pt-hotspot-dot { animation: pt-pulse 2.8s ease-out infinite; border-radius: 50%; display: block; }
  #shopify-section-{{ section.id }} .stl__popover {
    position: absolute;
    bottom: calc(100% + 1.6rem);
    left: 50%;
    width: min(25rem, 72vw);
    background: var(--pt-porcelain);
    border: 1px solid rgba(201, 169, 106, 0.4);
    box-shadow: 0 2.4rem 6rem rgba(24, 19, 14, 0.18);
    padding: 1.6rem;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.8rem);
    transition: opacity 0.4s ease, transform 0.45s var(--pt-ease), visibility 0.4s;
    z-index: 6;
  }
  #shopify-section-{{ section.id }} .stl__spot.is-open .stl__popover,
  #shopify-section-{{ section.id }} .stl__hotspot:focus-visible + .stl__popover {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  #shopify-section-{{ section.id }} .stl__popover--edge-l { left: 0; transform: translate(0, 0.8rem); }
  #shopify-section-{{ section.id }} .stl__spot.is-open .stl__popover--edge-l { transform: translate(0, 0); }
  #shopify-section-{{ section.id }} .stl__popover--edge-r { left: auto; right: 0; transform: translate(0, 0.8rem); }
  #shopify-section-{{ section.id }} .stl__spot.is-open .stl__popover--edge-r { transform: translate(0, 0); }
  #shopify-section-{{ section.id }} .stl__pop-media { aspect-ratio: 1; overflow: hidden; background: var(--pt-sand); margin-bottom: 1.2rem; }
  #shopify-section-{{ section.id }} .stl__pop-media img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .stl__pop-title { font-family: var(--pt-serif); font-size: 1.9rem; font-weight: 500; line-height: 1.3; }
  #shopify-section-{{ section.id }} .stl__pop-price { margin-top: 0.4rem; font-size: 1.45rem; color: var(--pt-slate); }
  #shopify-section-{{ section.id }} .stl__pop-link { margin-top: 1rem; display: inline-flex; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .stl__media { aspect-ratio: 16 / 10; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="stl__head">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker pt-reveal">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2 pt-reveal" style="--pt-reveal-delay: 0.1s;">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
    <div class="stl__stage pt-reveal" style="--pt-reveal-delay: 0.15s;">
      <div class="stl__media">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 1600 }}"
            srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
            sizes="100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            decoding="async">
        {%- else -%}
          <img
            src="{{ 'placeholder-lookbook-01.jpg' | asset_url }}"
            alt="{{ section.settings.heading | escape | default: 'Shop the look — Pitriciacle' }}"
            loading="lazy"
            decoding="async">
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign spot_product = block.settings.product -%}
        {%- if spot_product != blank -%}
          {%- assign px = block.settings.x | default: 50 -%}
          {%- assign edge = '' -%}
          {%- if px > 72 -%}{%- assign edge = ' stl__popover--edge-r' -%}
          {%- elsif px < 28 -%}{%- assign edge = ' stl__popover--edge-l' -%}{%- endif -%}
          <div class="stl__spot" style="left: {{ px }}%; top: {{ block.settings.y | default: 50 }}%;" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="stl__hotspot"
              data-hotspot
              aria-expanded="false"
              aria-label="{{ 'sections.shop_the_look.view_product' | t }}: {{ spot_product.title | escape }}">
              <span class="stl__dot pt-hotspot-dot" aria-hidden="true"></span>
            </button>
            <div class="stl__popover{{ edge }}" data-hotspot-popover role="dialog" aria-label="{{ spot_product.title | escape }}">
              <div class="stl__pop-media">
                {%- if spot_product.featured_media -%}
                  <img src="{{ spot_product.featured_media | image_url: width: 400 }}" alt="" loading="lazy" width="400" height="400">
                {%- else -%}
                  <img src="{{ 'placeholder-hero.jpg' | asset_url }}" alt="" loading="lazy" width="400" height="400">
                {%- endif -%}
              </div>
              <p class="stl__pop-title">{{ spot_product.title }}</p>
              <p class="stl__pop-price">{{ spot_product.price | money }}</p>
              <a href="{{ spot_product.url }}" class="pt-btn--quiet stl__pop-link">{{ 'sections.shop_the_look.view_piece' | t }}</a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop the look",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Look image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "In situ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "product": "rajwada-arch-mirror",
            "x": 24,
            "y": 42
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "product": "diwan-table-lamp",
            "x": 66,
            "y": 58
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "product": "gulnar-wool-rug",
            "x": 48,
            "y": 84
          }
        }
      ]
    }
  ]
}
{% endschema %}
