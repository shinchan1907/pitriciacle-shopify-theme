{%- comment -%} Pitriciacle · Lookbook — editorial masonry-style image grid {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .lb__head { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .lb__grid { columns: 1; column-gap: 1.5rem; }
  #shopify-section-{{ section.id }} .lb__item { break-inside: avoid; margin-bottom: 1.5rem; }
  #shopify-section-{{ section.id }} .lb__frame { overflow: hidden; background: var(--pt-sand); display: block; }
  #shopify-section-{{ section.id }} .lb__frame img { width: 100%; height: auto; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .lb__frame:hover img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .lb__caption { margin: 0.9rem 0 0; text-align: center; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .lb__grid { columns: 2; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .lb__grid { columns: 3; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="lb__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lb__grid">
        {%- for block in section.blocks -%}
          {%- assign lb_cycle = forloop.index0 | modulo: 3 -%}
          {%- if lb_cycle == 0 -%}
            {%- assign lb_fb = 'placeholder-lookbook-01.jpg' -%}
          {%- elsif lb_cycle == 1 -%}
            {%- assign lb_fb = 'placeholder-lookbook-02.jpg' -%}
          {%- else -%}
            {%- assign lb_fb = 'placeholder-lookbook-03.jpg' -%}
          {%- endif -%}
          <figure class="lb__item pt-reveal" {{ block.shopify_attributes }}>
            <span class="lb__frame">
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <img
                  src="{{ lb_fb | asset_url }}"
                  alt="{{ block.settings.caption | escape | default: 'Pitriciacle lookbook' }}"
                  loading="lazy"
                  decoding="async">
              {%- endif -%}
            </span>
            {%- if block.settings.caption != blank -%}
              <figcaption class="lb__caption pt-kicker">{{ block.settings.caption | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "In situ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lookbook"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Morning, in brass and linen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "caption": "Morning, in brass and linen"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "The arch holds the light"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "A quiet corner, kept"
          }
        }
      ]
    }
  ]
}
{% endschema %}
