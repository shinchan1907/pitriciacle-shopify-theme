{%- comment -%} Pitriciacle · Craft story — narrative, image and stat blocks {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .cs__head { text-align: center; max-width: 64ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .cs__body { margin-top: 1.25rem; }
  #shopify-section-{{ section.id }} .cs__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 16 / 9; margin-bottom: 3rem; }
  #shopify-section-{{ section.id }} .cs__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .cs__media:hover img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .cs__stats { display: grid; grid-template-columns: 1fr; gap: 2rem; text-align: center; border-top: 1px solid rgba(138,129,120,0.35); padding-top: 2.5rem; }
  #shopify-section-{{ section.id }} .cs__value { font-family: var(--pt-serif); font-weight: 400; font-size: 2.75rem; line-height: 1; color: var(--pt-ink); margin: 0 0 0.6rem; }
  #shopify-section-{{ section.id }} .cs__value em { color: var(--pt-ink); font-style: italic; }
  #shopify-section-{{ section.id }} .cs__cta { text-align: center; margin-top: 3rem; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .cs__stats { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    #shopify-section-{{ section.id }} .cs__media { aspect-ratio: 21 / 9; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="cs__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="pt-lede cs__body">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="cs__media pt-reveal">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
          decoding="async">
      {%- else -%}
        <img
          src="{{ 'placeholder-craft-01.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape | default: 'Artisan hands at work in the Pitriciacle atelier' }}"
          loading="lazy"
          decoding="async">
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cs__stats pt-reveal">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.value != blank -%}
              <p class="cs__value">{{ block.settings.value | escape }}</p>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <p class="pt-kicker">{{ block.settings.label | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="cs__cta pt-reveal">
        <a href="{{ section.settings.cta_link | default: '/pages/heritage' }}" class="pt-btn--quiet">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Craft story",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our Craft"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hands that remember"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Behind every Pitriciacle object is a craftsperson who learned at someone's shoulder \u2014 beating brass in Moradabad, weaving wool on wooden looms, framing mirrors in seasoned mango wood. We don't chase seasons; we keep skills alive.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Discover our heritage"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link",
      "default": "/pages/heritage"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "120+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Artisan partners"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craft story",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "120+",
            "label": "Artisan partners"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "6",
            "label": "Craft clusters across India"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "Hand-finished pieces"
          }
        }
      ]
    }
  ]
}
{% endschema %}
