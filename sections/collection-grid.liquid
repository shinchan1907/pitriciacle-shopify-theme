{%- comment -%} Pitriciacle · Collection grid — four editorial tiles {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .cg__head { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .cg__sub { margin-top: 1rem; }
  #shopify-section-{{ section.id }} .cg__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  #shopify-section-{{ section.id }} .cg__tile { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 4; background: var(--pt-sand); text-decoration: none; }
  #shopify-section-{{ section.id }} .cg__tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .cg__tile:hover img, #shopify-section-{{ section.id }} .cg__tile:focus-visible img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .cg__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(24,19,14,0.52) 0%, rgba(24,19,14,0) 55%); }
  #shopify-section-{{ section.id }} .cg__label { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; color: var(--pt-porcelain); display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  #shopify-section-{{ section.id }} .cg__title { font-family: var(--pt-serif); font-weight: 400; font-size: 1.45rem; line-height: 1.15; margin: 0; }
  #shopify-section-{{ section.id }} .cg__rule { width: 2.25rem; height: 1px; background: var(--pt-champagne); margin-bottom: 0.6rem; }
  #shopify-section-{{ section.id }} .cg__go { flex: none; width: 2.25rem; height: 2.25rem; border: 1px solid rgba(250,248,244,0.55); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; transition: background 0.4s ease, border-color 0.4s ease; }
  #shopify-section-{{ section.id }} .cg__go svg { width: 1rem; height: 1rem; }
  #shopify-section-{{ section.id }} .cg__tile:hover .cg__go, #shopify-section-{{ section.id }} .cg__tile:focus-visible .cg__go { background: var(--pt-champagne); border-color: var(--pt-champagne); color: var(--pt-ink); }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .cg__grid { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    #shopify-section-{{ section.id }} .cg__title { font-size: 1.65rem; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="cg__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pt-lede cg__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="cg__grid">
      {%- for block in section.blocks -%}
        {%- capture tile_key -%}{%- if block.settings.collection -%}{{ block.settings.collection.handle }} {% endif -%}{{ block.settings.title | downcase }}{%- endcapture -%}
        {%- assign tile_fb = 'placeholder-hero.jpg' -%}
        {%- if tile_key contains 'mirror' -%}
          {%- assign tile_fb = 'placeholder-collection-mirrors.jpg' -%}
        {%- elsif tile_key contains 'light' -%}
          {%- assign tile_fb = 'placeholder-collection-lighting.jpg' -%}
        {%- elsif tile_key contains 'rug' or tile_key contains 'runner' -%}
          {%- assign tile_fb = 'placeholder-collection-rugs.jpg' -%}
        {%- elsif tile_key contains 'metal' or tile_key contains 'brass' or tile_key contains 'object' -%}
          {%- assign tile_fb = 'placeholder-collection-metals.jpg' -%}
        {%- endif -%}
        {%- assign tile_title = block.settings.title | default: block.settings.collection.title -%}
        {%- assign tile_alt = tile_title | default: 'Collection' | escape -%}
        {%- if block.settings.image -%}
          {%- assign tile_src = block.settings.image | image_url: width: 900 -%}
          {%- assign tile_alt = block.settings.image.alt | default: tile_title | escape -%}
        {%- else -%}
          {%- assign tile_src = tile_fb | asset_url -%}
        {%- endif -%}

        {%- if block.settings.collection -%}
          <a href="{{ block.settings.collection.url }}" class="cg__tile pt-reveal" {{ block.shopify_attributes }} aria-label="Shop {{ tile_title | escape }}">
        {%- else -%}
          <div class="cg__tile pt-reveal" {{ block.shopify_attributes }}>
        {%- endif -%}
            <img src="{{ tile_src }}" alt="{{ tile_alt }}" loading="lazy" decoding="async">
            <span class="cg__shade" aria-hidden="true"></span>
            <span class="cg__label">
              <span>
                <span class="cg__rule" aria-hidden="true"></span>
                {%- if tile_title != blank -%}
                  <span class="cg__title">{{ tile_title | escape }}</span>
                {%- endif -%}
              </span>
              <span class="cg__go" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span>
            </span>
        {%- if block.settings.collection -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by room & ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Four crafts, one philosophy \u2014 pieces that belong to the rhythm of your home."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (falls back to a collection placeholder)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Mirrors"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Lighting"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Rugs & Runners"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Metal Objects"
          }
        }
      ]
    }
  ]
}
{% endschema %}
