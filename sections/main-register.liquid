{%- comment -%} Pitriciacle · Main register — create account {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .auth { max-width: 28rem; margin: 0 auto; text-align: center; }
  #shopify-section-{{ section.id }} .auth h1 { margin: 1rem 0 2rem; }
  #shopify-section-{{ section.id }} .auth__field { text-align: left; margin-bottom: 1.25rem; }
  #shopify-section-{{ section.id }} .auth__field .pt-label { display: block; margin-bottom: 0.5rem; }
  #shopify-section-{{ section.id }} .auth__field .pt-input { width: 100%; }
  #shopify-section-{{ section.id }} .auth__names { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  #shopify-section-{{ section.id }} .auth__submit { width: 100%; margin-top: 0.5rem; }
  #shopify-section-{{ section.id }} .auth__links { margin-top: 1.75rem; }
  #shopify-section-{{ section.id }} .auth__errors { text-align: left; margin-bottom: 1.5rem; }
  #shopify-section-{{ section.id }} .auth__errors ul { margin: 0; padding-left: 1.25rem; }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="auth">
      <p class="pt-kicker">{{ 'customer.join_atelier' | t }}</p>
      <h1 class="pt-h1">{{ section.settings.heading | escape | default: 'Create an account' }}</h1>
      {% form 'create_customer' %}
        {%- if form.errors -%}
          <div class="auth__errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="auth__names">
          <div class="auth__field">
            <label class="pt-label" for="reg-first-{{ section.id }}">{{ 'customer.first_name' | t }}</label>
            <input type="text" name="customer[first_name]" id="reg-first-{{ section.id }}" class="pt-input" autocomplete="given-name">
          </div>
          <div class="auth__field">
            <label class="pt-label" for="reg-last-{{ section.id }}">{{ 'customer.last_name' | t }}</label>
            <input type="text" name="customer[last_name]" id="reg-last-{{ section.id }}" class="pt-input" autocomplete="family-name">
          </div>
        </div>
        <div class="auth__field">
          <label class="pt-label" for="reg-email-{{ section.id }}">{{ 'customer.email' | t }}</label>
          <input type="email" name="customer[email]" id="reg-email-{{ section.id }}" class="pt-input" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>
        <div class="auth__field">
          <label class="pt-label" for="reg-password-{{ section.id }}">{{ 'customer.password' | t }}</label>
          <input type="password" name="customer[password]" id="reg-password-{{ section.id }}" class="pt-input" autocomplete="new-password" required>
        </div>
        <button type="submit" class="pt-btn auth__submit">{{ 'customer.create_account' | t }}</button>
      {% endform %}
      <div class="auth__links">
        <a href="{{ routes.account_login_url }}" class="pt-btn--quiet">Already have an account? Sign in</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create an account"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Register"
    }
  ]
}
{% endschema %}
