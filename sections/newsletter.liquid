<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'sand' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container pt-text-center" style="max-width: 72rem; margin-left: auto; margin-right: auto;">
    {%- if section.settings.kicker != blank -%}
      <p class="pt-kicker pt-reveal">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="pt-h2 pt-reveal">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="pt-body pt-muted pt-reveal" style="margin-top: 1.6rem;">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'pt-stack pt-reveal', style: 'margin-top: 3.2rem;' -%}
      {%- if form.posted_successfully? -%}
        <p class="pt-form-success" role="status">
          {% render 'icons', icon: 'check' %}
          {{ 'newsletter.success' | t }}
        </p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display: flex; gap: 1.2rem; flex-wrap: wrap; justify-content: center;">
          <label class="pt-visually-hidden" for="Newsletter-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            type="email"
            id="Newsletter-{{ section.id }}"
            name="contact[email]"
            class="pt-input"
            style="max-width: 36rem; background: var(--pt-porcelain);"
            placeholder="{{ 'newsletter.placeholder' | t }}"
            value="{{ form.email }}"
            required
            autocomplete="email"
            aria-describedby="Newsletter-error-{{ section.id }}">
          <button type="submit" class="pt-btn">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <p class="pt-form-error" id="Newsletter-error-{{ section.id }}" role="alert">{{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The inner circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Letters from the atelier"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New pieces, artisan stories and private previews \u2014 once a month, never more."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
