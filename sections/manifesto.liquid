{%- comment -%} Pitriciacle · Manifesto — full-bleed oversized serif statement {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .manifesto { text-align: center; padding-top: var(--pt-pad-top, clamp(8rem, 13vw, 15rem)); padding-bottom: var(--pt-pad-bottom, clamp(8rem, 13vw, 15rem)); }
  #shopify-section-{{ section.id }} .manifesto__statement {
    font-family: var(--pt-serif);
    font-weight: 300;
    font-size: clamp(2.7rem, 5.2vw, 5.4rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    max-width: 24ch;
    margin: 2.4rem auto 0;
  }
  #shopify-section-{{ section.id }} .manifesto__statement em { font-style: italic; color: var(--pt-champagne); }
  #shopify-section-{{ section.id }} .manifesto__rule { width: 4.8rem; height: 1px; background: var(--pt-champagne); margin: 3.6rem auto 0; }
</style>

<section class="manifesto pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %} aria-label="{{ section.settings.kicker | escape | default: 'Our philosophy' }}">
  <div class="pt-container">
    {%- if section.settings.kicker != blank -%}
      <p class="pt-kicker pt-reveal" style="margin-bottom: 0;">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.statement != blank -%}
      <div class="manifesto__statement pt-reveal" style="--pt-reveal-delay: 0.15s;">{{ section.settings.statement }}</div>
    {%- endif -%}
    <div class="manifesto__rule pt-reveal" style="--pt-reveal-delay: 0.3s;" aria-hidden="true"></div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Pitriciacle philosophy"
    },
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "default": "<p>We believe a home should hold its light <em>gently</em> \u2014 that true luxury is <em>quiet</em>, and that the objects we live with should outlive us <em>gracefully</em>.</p>",
      "info": "Italicised words render in champagne."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Manifesto"
    }
  ]
}
{% endschema %}
