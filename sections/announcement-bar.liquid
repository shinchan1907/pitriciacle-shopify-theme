<div class="pt-announcement pt-scheme--{{ section.settings.color_scheme | default: 'ink' }}{% if section.settings.show_divider %} pt-announcement--divided{% endif %}">
  <div class="pt-announcement__list" role="list"{% if section.blocks.size > 1 %} data-announcement-rotate{% endif %}>
    {%- for block in section.blocks -%}
      <div class="pt-announcement__item" role="listitem" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "porcelain", "label": "Porcelain" },
        { "value": "sand", "label": "Sand" },
        { "value": "sage", "label": "Sage" },
        { "value": "blush", "label": "Blush" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show dividers between messages",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Complimentary shipping across India on orders above ₹15,000" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message" }
    ]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message" },
        { "type": "message", "settings": { "text": "Handcrafted in India · Insured worldwide shipping" } },
        { "type": "message", "settings": { "text": "The Festive Edit — new brass & copper pieces have arrived" } }
      ]
    }
  ]
}
{% endschema %}
