{%- comment -%} Pitriciacle · Main login — sign in and password recovery {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .auth { max-width: 28rem; margin: 0 auto; text-align: center; }
  #shopify-section-{{ section.id }} .auth h1 { margin: 1rem 0 2rem; }
  #shopify-section-{{ section.id }} .auth__field { text-align: left; margin-bottom: 1.25rem; }
  #shopify-section-{{ section.id }} .auth__field .pt-label { display: block; margin-bottom: 0.5rem; }
  #shopify-section-{{ section.id }} .auth__field .pt-input { width: 100%; }
  #shopify-section-{{ section.id }} .auth__submit { width: 100%; margin-top: 0.5rem; }
  #shopify-section-{{ section.id }} .auth__links { margin-top: 1.75rem; display: flex; flex-direction: column; gap: 0.75rem; }
  #shopify-section-{{ section.id }} .auth__errors { text-align: left; margin-bottom: 1.5rem; }
  #shopify-section-{{ section.id }} .auth__errors ul { margin: 0; padding-left: 1.25rem; }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="auth">
      <div id="auth-login">
        <p class="pt-kicker">{{ 'customer.welcome_back' | t }}</p>
        <h1 class="pt-h1">{{ section.settings.heading | escape | default: 'Sign in' }}</h1>
        {% form 'customer_login' %}
          {%- if form.errors -%}
            <div class="auth__errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="auth__field">
            <label class="pt-label" for="login-email-{{ section.id }}">{{ 'customer.email' | t }}</label>
            <input type="email" name="customer[email]" id="login-email-{{ section.id }}" class="pt-input" autocomplete="email" autocapitalize="off" spellcheck="false" required>
          </div>
          <div class="auth__field">
            <label class="pt-label" for="login-password-{{ section.id }}">{{ 'customer.password' | t }}</label>
            <input type="password" name="customer[password]" id="login-password-{{ section.id }}" class="pt-input" autocomplete="current-password" required>
          </div>
          <button type="submit" class="pt-btn auth__submit">{{ 'customer.sign_in' | t }}</button>
        {% endform %}
        <div class="auth__links">
          <a href="#recover" class="pt-btn--quiet" data-auth-toggle="recover">Forgot your password?</a>
          <a href="{{ routes.account_register_url }}" class="pt-btn--quiet">{{ 'customer.create_account' | t }}</a>
        </div>
      </div>

      <div id="auth-recover" hidden>
        <p class="pt-kicker">{{ 'customer.forgot_password' | t }}</p>
        <h1 class="pt-h1">{{ 'customer.reset_password' | t }}</h1>
        <p class="pt-body pt-muted">We will send you an email to reset your password.</p>
        {% form 'recover_customer_password' %}
          {%- if form.errors -%}
            <div class="auth__errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="pt-body">Please check your inbox for the reset link.</p>
          {%- else -%}
            <div class="auth__field">
              <label class="pt-label" for="recover-email-{{ section.id }}">{{ 'customer.email' | t }}</label>
              <input type="email" name="email" id="recover-email-{{ section.id }}" class="pt-input" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            </div>
            <button type="submit" class="pt-btn auth__submit">{{ 'customer.submit' | t }}</button>
          {%- endif -%}
        {% endform %}
        <div class="auth__links">
          <a href="#login" class="pt-btn--quiet" data-auth-toggle="login">{{ 'customer.back_to_sign_in' | t }}</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;
  var login = root.querySelector('#auth-login');
  var recover = root.querySelector('#auth-recover');
  function show(which) {
    if (which === 'recover') {
      if (login) login.hidden = true;
      if (recover) recover.hidden = false;
    } else {
      if (recover) recover.hidden = true;
      if (login) login.hidden = false;
    }
  }
  Array.prototype.forEach.call(root.querySelectorAll('[data-auth-toggle]'), function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      show(link.getAttribute('data-auth-toggle'));
    });
  });
  if (window.location.hash === '#recover') show('recover');
})();
</script>

{% schema %}
{
  "name": "Login",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign in"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Login"
    }
  ]
}
{% endschema %}
