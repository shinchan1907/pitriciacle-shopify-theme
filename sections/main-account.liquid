{%- comment -%} Pitriciacle · Main account — orders and details {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .acc { max-width: 62rem; margin: 0 auto; }
  #shopify-section-{{ section.id }} .acc__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 3rem; }
  #shopify-section-{{ section.id }} .acc__top h1 { margin: 0.75rem 0 0; }
  #shopify-section-{{ section.id }} .acc__section-title { margin: 0 0 1.5rem; }
  #shopify-section-{{ section.id }} .acc__orders { margin-bottom: 4rem; }
  #shopify-section-{{ section.id }} .acc__tablewrap { overflow-x: auto; border-top: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .acc__table { width: 100%; border-collapse: collapse; min-width: 38rem; }
  #shopify-section-{{ section.id }} .acc__table th { text-align: left; font-family: var(--pt-sans); font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--pt-stone); font-weight: 500; padding: 1rem 1rem 1rem 0; border-bottom: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .acc__table td { padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid rgba(138,129,120,0.2); vertical-align: top; }
  #shopify-section-{{ section.id }} .acc__table a { color: inherit; text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.2em; }
  #shopify-section-{{ section.id }} .acc__address { margin-bottom: 1.75rem; line-height: 1.8; }
</style>

<div class="pt-section">
  <div class="pt-container">
    <div class="acc">
      <div class="acc__top">
        <div>
          <p class="pt-kicker">{{ 'customer.account' | t }}</p>
          <h1 class="pt-h1">Hello, {{ customer.first_name | escape }}</h1>
        </div>
        <a href="{{ routes.account_logout_url }}" class="pt-btn--quiet">{{ 'customer.log_out' | t }}</a>
      </div>

      <div class="acc__orders">
        <h2 class="pt-h2 acc__section-title">{{ 'customer.order_history' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <div class="acc__tablewrap">
            <table class="acc__table">
              <thead>
                <tr>
                  <th scope="col">{{ 'customer.order' | t }}</th>
                  <th scope="col">{{ 'customer.date' | t }}</th>
                  <th scope="col">{{ 'customer.payment' | t }}</th>
                  <th scope="col">{{ 'customer.fulfilment' | t }}</th>
                  <th scope="col">{{ 'customer.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name | escape }}</a></td>
                    <td>{{ order.created_at | time_tag: '%B %d, %Y' }}</td>
                    <td>{{ order.financial_status_label | escape }}</td>
                    <td>{{ order.fulfillment_status_label | escape }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="pt-body pt-muted">You have not placed any orders yet — when you do, they will appear here.</p>
        {%- endif -%}
      </div>

      <div>
        <h2 class="pt-h2 acc__section-title">{{ 'customer.account_details' | t }}</h2>
        {%- if customer.default_address -%}
          <div class="pt-body acc__address">{{ customer.default_address | format_address }}</div>
        {%- else -%}
          <p class="pt-body pt-muted">No default address saved yet.</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="pt-btn--outline">{{ 'customer.view_addresses' | t }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "settings": [],
  "presets": [{ "name": "Account" }]
}
{% endschema %}
