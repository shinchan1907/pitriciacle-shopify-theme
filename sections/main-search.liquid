{%- comment -%} Pitriciacle · Main search — form and results grid {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .ms__head { text-align: center; max-width: 40rem; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .ms__form { display: flex; gap: 0.75rem; margin-top: 2rem; }
  #shopify-section-{{ section.id }} .ms__form input { flex: 1; }
  #shopify-section-{{ section.id }} .ms__count { text-align: center; margin-bottom: 2.5rem; }
  #shopify-section-{{ section.id }} .ms__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  #shopify-section-{{ section.id }} .ms__others { max-width: 46rem; margin: 3rem auto 0; border-top: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .ms__other { display: block; padding: 1.25rem 0; border-bottom: 1px solid rgba(138,129,120,0.35); text-decoration: none; color: inherit; }
  #shopify-section-{{ section.id }} .ms__other:hover .ms__other-title { text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.25em; }
  #shopify-section-{{ section.id }} .ms__other-title { font-family: var(--pt-serif); font-size: 1.3rem; margin: 0 0 0.3rem; }
  #shopify-section-{{ section.id }} .ms__empty { text-align: center; padding: 3rem 0; max-width: 52ch; margin: 0 auto; }
  #shopify-section-{{ section.id }} .ms__pages { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin-top: 3.5rem; }
  #shopify-section-{{ section.id }} .ms__pages a, #shopify-section-{{ section.id }} .ms__pages span { min-width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; color: var(--pt-ink); border: 1px solid transparent; font-size: 0.95rem; padding: 0 0.5rem; }
  #shopify-section-{{ section.id }} .ms__pages a:hover { border-color: var(--pt-champagne); }
  #shopify-section-{{ section.id }} .ms__pages .is-current { border-color: var(--pt-ink); }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .ms__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem 1.5rem; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .ms__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="ms__head">
      <p class="pt-kicker">{{ 'general.search.search' | t }}</p>
      <h1 class="pt-h1">
        {%- if search.performed and search.terms != blank -%}
          Results for &ldquo;{{ search.terms | escape }}&rdquo;
        {%- elsif section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- else -%}
          Search the atelier
        {%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="ms__form">
        <input type="search" name="q" class="pt-input" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <button type="submit" class="pt-btn">{{ 'general.search.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {% paginate search.results by 24 %}
        {%- if search.results_count > 0 -%}
          <p class="pt-kicker ms__count">
            {%- if search.results_count == 1 -%}1 result{%- else -%}{{ search.results_count }} results{%- endif -%}
          </p>
          <div class="ms__grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- assign has_others = false -%}
          {%- for item in search.results -%}
            {%- unless item.object_type == 'product' -%}
              {%- assign has_others = true -%}
            {%- endunless -%}
          {%- endfor -%}
          {%- if has_others -%}
            <div class="ms__others">
              {%- for item in search.results -%}
                {%- unless item.object_type == 'product' -%}
                  <a href="{{ item.url }}" class="ms__other">
                    <p class="pt-kicker">{{ item.object_type }}</p>
                    <p class="ms__other-title">{{ item.title | escape }}</p>
                    {%- if item.content != blank -%}
                      <p class="pt-body pt-muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
                    {%- endif -%}
                  </a>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="ms__pages" aria-label="{{ 'collection.pagination' | t }}">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" aria-label="{{ 'collection.previous_page' | t }}">&larr; {{ 'collection.prev' | t }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" aria-label="{{ 'collection.go_to_page' | t }} {{ part.title }}">{{ part.title }}</a>
                {%- elsif part.title == '&hellip;' -%}
                  <span aria-hidden="true">{{ part.title }}</span>
                {%- else -%}
                  <span class="is-current" aria-current="page">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" aria-label="{{ 'collection.next_page' | t }}">{{ 'collection.next' | t }} &rarr;</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="ms__empty">
            <p class="pt-lede">Nothing found for &ldquo;{{ search.terms | escape }}&rdquo;.</p>
            <p class="pt-body pt-muted">Try a single word — &ldquo;mirror&rdquo;, &ldquo;brass&rdquo;, &ldquo;rug&rdquo; — or wander the collections instead.</p>
            <a href="{{ routes.all_products_collection_url }}" class="pt-btn--outline">{{ 'search.browse_all' | t }}</a>
          </div>
        {%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (shown before a search is run)",
      "default": "Search the atelier"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Search"
    }
  ]
}
{% endschema %}
