{%- comment -%} Pitriciacle · Main article — image, content, prev/next {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .ma { max-width: 46rem; margin: 0 auto; }
  #shopify-section-{{ section.id }} .ma__crumbs { margin-bottom: 2rem; }
  #shopify-section-{{ section.id }} .ma__head { text-align: center; margin-bottom: 2.5rem; }
  #shopify-section-{{ section.id }} .ma__title { margin: 1rem 0; }
  #shopify-section-{{ section.id }} .ma__meta { margin: 0; }
  #shopify-section-{{ section.id }} .ma__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 16 / 9; margin-bottom: 2.5rem; }
  #shopify-section-{{ section.id }} .ma__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .ma__content { line-height: 1.8; }
  #shopify-section-{{ section.id }} .ma__content h2 { font-family: var(--pt-serif); font-weight: 500; font-size: 1.75rem; margin: 2.5rem 0 1rem; }
  #shopify-section-{{ section.id }} .ma__content h3 { font-family: var(--pt-serif); font-weight: 500; font-size: 1.4rem; margin: 2rem 0 0.75rem; }
  #shopify-section-{{ section.id }} .ma__content img { max-width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .ma__content a { color: var(--pt-ink); text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.2em; }
  #shopify-section-{{ section.id }} .ma__tags { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .ma__nav { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .ma__nav a { text-decoration: none; color: inherit; display: flex; align-items: center; gap: 0.9rem; }
  #shopify-section-{{ section.id }} .ma__nav a:hover .ma__nav-title { text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.25em; }
  #shopify-section-{{ section.id }} .ma__nav .is-next { justify-content: flex-end; text-align: right; }
  #shopify-section-{{ section.id }} .ma__nav svg { width: 1.1rem; height: 1.1rem; flex: none; color: var(--pt-champagne); }
  #shopify-section-{{ section.id }} .ma__nav-title { font-family: var(--pt-serif); font-size: 1.25rem; margin: 0.3rem 0 0; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .ma__nav { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <article class="ma">
      <div class="ma__crumbs">{% render 'breadcrumbs' %}</div>

      <header class="ma__head pt-reveal">
        <p class="pt-kicker">{{ blog.title | escape }}</p>
        <h1 class="pt-h1 ma__title">{{ article.title | escape }}</h1>
        <p class="pt-muted ma__meta">
          {{ article.published_at | time_tag: '%B %d, %Y' }}
          {%- if article.author != blank -%} &nbsp;&middot;&nbsp; {{ article.author | escape }}{%- endif -%}
        </p>
      </header>

      <div class="ma__media pt-reveal">
        {%- if article.image -%}
          <img
            src="{{ article.image | image_url: width: 1400 }}"
            srcset="{{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 990px) 736px, 100vw"
            alt="{{ article.image.alt | default: article.title | escape }}"
            fetchpriority="high"
            loading="eager"
            decoding="async">
        {%- else -%}
          <img
            src="{{ 'placeholder-lookbook-01.jpg' | asset_url }}"
            alt="{{ article.title | escape }}"
            loading="lazy"
            decoding="async">
        {%- endif -%}
      </div>

      <div class="pt-body ma__content">{{ article.content }}</div>

      {%- if article.tags.size > 0 -%}
        <div class="ma__tags">
          <p class="pt-kicker">{{ 'article.filed_under' | t }}</p>
          <p class="pt-body">{{ article.tags | join: ', ' }}</p>
        </div>
      {%- endif -%}

      {%- if blog.previous_article or blog.next_article -%}
        <nav class="ma__nav" aria-label="{{ 'article.more_articles' | t }}">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article.url }}" aria-label="Previous article: {{ blog.previous_article.title | escape }}">
              {% render 'icons', icon: 'arrow-left' %}
              <span>
                <span class="pt-kicker">{{ 'article.older' | t }}</span>
                <span class="ma__nav-title">{{ blog.previous_article.title | escape }}</span>
              </span>
            </a>
          {%- else -%}
            <span></span>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a href="{{ blog.next_article.url }}" class="is-next" aria-label="Next article: {{ blog.next_article.title | escape }}">
              <span>
                <span class="pt-kicker">{{ 'article.newer' | t }}</span>
                <span class="ma__nav-title">{{ blog.next_article.title | escape }}</span>
              </span>
              {% render 'icons', icon: 'arrow-right' %}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </article>
  </div>
</div>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Article"
    }
  ]
}
{% endschema %}
