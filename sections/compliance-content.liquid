{%- comment -%} Pitriciacle · Compliance content — renders policy title and body in a narrow column {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .cmp { max-width: 72ch; margin: 0 auto; }
  #shopify-section-{{ section.id }} .cmp__title { margin: 1rem 0 2rem; }
  #shopify-section-{{ section.id }} .cmp__body h2 { font-family: var(--pt-serif); font-weight: 500; font-size: 1.5rem; margin: 2.5rem 0 1rem; }
  #shopify-section-{{ section.id }} .cmp__body h3 { font-family: var(--pt-serif); font-weight: 500; font-size: 1.25rem; margin: 2rem 0 0.75rem; }
  #shopify-section-{{ section.id }} .cmp__body p, #shopify-section-{{ section.id }} .cmp__body li { line-height: 1.75; }
  #shopify-section-{{ section.id }} .cmp__body a { color: var(--pt-ink); text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.2em; }
  #shopify-section-{{ section.id }} .cmp__updated { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(138,129,120,0.35); }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="cmp pt-reveal">
      {%- if policy -%}
        <p class="pt-kicker">Pitriciacle</p>
        <h1 class="pt-h1 cmp__title">{{ policy.title | escape }}</h1>
        <div class="pt-body cmp__body">{{ policy.body }}</div>
      {%- else -%}
        <p class="pt-kicker">Pitriciacle</p>
        <h1 class="pt-h1 cmp__title">{{ 'policy.fallback_heading' | t }}</h1>
        <div class="pt-body cmp__body">
          <p>{{ 'policy.fallback_body' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy content",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Policy content"
    }
  ]
}
{% endschema %}
