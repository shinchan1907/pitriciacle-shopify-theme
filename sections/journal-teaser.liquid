{%- comment -%} Pitriciacle · Journal teaser — latest articles from a blog {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .jt__head { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .jt__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  #shopify-section-{{ section.id }} .jt__card { text-decoration: none; color: inherit; display: block; }
  #shopify-section-{{ section.id }} .jt__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 4 / 3; margin-bottom: 1.4rem; }
  #shopify-section-{{ section.id }} .jt__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .jt__card:hover .jt__media img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .jt__date { margin: 0 0 0.7rem; }
  #shopify-section-{{ section.id }} .jt__title { margin: 0 0 0.7rem; }
  #shopify-section-{{ section.id }} .jt__card:hover .jt__title { text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.25em; }
  #shopify-section-{{ section.id }} .jt__excerpt { margin: 0; }
  #shopify-section-{{ section.id }} .jt__more { text-align: center; margin-top: 3rem; }
  #shopify-section-{{ section.id }} .jt__empty { text-align: center; padding: 2rem 0; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .jt__grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="jt__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.blog -%}
      {%- assign jt_blog = section.settings.blog -%}
      <div class="jt__grid">
        {%- for article in jt_blog.articles limit: section.settings.posts_to_show -%}
          <a href="{{ article.url }}" class="jt__card pt-reveal" aria-label="Read: {{ article.title | escape }}">
            <span class="jt__media">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 750px) 33vw, 100vw"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <img
                  src="{{ 'placeholder-lookbook-01.jpg' | asset_url }}"
                  alt="{{ article.title | escape }}"
                  loading="lazy"
                  decoding="async">
              {%- endif -%}
            </span>
            <p class="pt-kicker jt__date">{{ article.published_at | time_tag: '%B %d, %Y' }}</p>
            <h3 class="pt-h3 jt__title">{{ article.title | escape }}</h3>
            {%- if article.excerpt_or_content != blank -%}
              <p class="pt-body pt-muted jt__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      <div class="jt__more pt-reveal">
        <a href="{{ jt_blog.url }}" class="pt-btn--quiet">{{ 'blog.all_entries' | t }}</a>
      </div>
    {%- else -%}
      <div class="jt__empty">
        <p class="pt-muted">Choose a blog to show its latest entries here.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Journal teaser",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notes on living beautifully"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Articles to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Journal teaser"
    }
  ]
}
{% endschema %}
