{%- comment -%} Pitriciacle · Main 404 — elegant not-found page {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .m404 { text-align: center; max-width: 44rem; margin: 0 auto; padding: 4rem 0; }
  #shopify-section-{{ section.id }} .m404__numeral { font-family: var(--pt-serif); font-weight: 300; font-size: clamp(5rem, 14vw, 9rem); line-height: 1; color: var(--pt-champagne); margin: 1.5rem 0 0; }
  #shopify-section-{{ section.id }} .m404__title { margin: 1rem 0; }
  #shopify-section-{{ section.id }} .m404__text { margin: 0 auto 2.5rem; max-width: 40ch; }
  #shopify-section-{{ section.id }} .m404__ctas { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
  #shopify-section-{{ section.id }} .m404__rule { width: 3rem; height: 1px; background: var(--pt-champagne); margin: 2.5rem auto 0; }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="m404 pt-reveal">
      <p class="pt-kicker">{{ 'page_404.kicker' | t }}</p>
      <p class="m404__numeral" aria-hidden="true">404</p>
      <h1 class="pt-h1 m404__title">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ 'page_404.default_heading' | t }}{%- endif -%}
      </h1>
      <p class="pt-lede pt-muted m404__text">
        {%- if section.settings.subtext != blank -%}{{ section.settings.subtext | escape }}{%- else -%}{{ 'page_404.default_subtext' | t }}{%- endif -%}
      </p>
      <div class="m404__ctas">
        <a href="{{ routes.root_url }}" class="pt-btn">{{ 'page_404.home_button' | t }}</a>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="pt-btn--outline">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="m404__rule" aria-hidden="true"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Not found",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page has wandered off"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Text",
      "default": "The page you are looking for has moved, or never existed. The atelier, however, is right where you left it."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Second button label",
      "default": "Browse the collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Second button link",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Not found"
    }
  ]
}
{% endschema %}
