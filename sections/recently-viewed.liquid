{%- comment -%}
  Pitriciacle · Recently viewed — renders from localStorage (pt_recently_viewed).
  Populated client-side via /products/{handle}.js; stays hidden when empty.
{%- endcomment -%}
<section
  data-recently-viewed
  data-rv-limit="{{ section.settings.count | default: 4 }}"
  aria-label="{{ 'products.recently_viewed.heading' | t }}"
  hidden>
  <div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
    <div class="pt-container">
      <h2 class="pt-h2 pt-text-center" style="margin-bottom: 3rem;">{{ section.settings.heading | default: 'products.recently_viewed.heading' | t | escape }}</h2>
      <div class="pt-rv__grid" data-rv-grid></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "porcelain", "label": "Porcelain" },
        { "value": "sand", "label": "Sand" },
        { "value": "sage", "label": "Sage" },
        { "value": "blush", "label": "Blush" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "porcelain"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 uses the theme default spacing." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 uses the theme default spacing." }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
