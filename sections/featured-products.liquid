{%- comment -%} Pitriciacle · Featured products — collection-driven product grid {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .fp__head { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .fp__sub { margin-top: 1rem; }
  #shopify-section-{{ section.id }} .fp__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  #shopify-section-{{ section.id }} .fp__cta { text-align: center; margin-top: 3rem; }
  #shopify-section-{{ section.id }} .fp__empty { text-align: center; padding: 3rem 0; }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .fp__grid { grid-template-columns: repeat(4, 1fr); gap: 2rem 1.5rem; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="fp__head pt-reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pt-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pt-lede fp__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.collection -%}
      <div class="fp__grid">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <div class="fp__cta pt-reveal">
          <a href="{{ section.settings.cta_link | default: section.settings.collection.url }}" class="pt-btn--outline">{{ section.settings.cta_label | escape }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="fp__empty">
        <p class="pt-muted">Choose a collection to feature its pieces here.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Curated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Mirror Edit"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Arches, jharokhas and quiet brass \u2014 mirrors that hold a room together."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View all mirrors"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
