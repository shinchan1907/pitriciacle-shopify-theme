<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container" style="max-width: 88rem;">
    {%- if section.settings.kicker != blank -%}
      <p class="pt-kicker pt-reveal">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h2 class="pt-h2 pt-reveal" style="margin-bottom: 3.2rem;">{{ section.settings.heading | escape }}</h2>

    <div class="pt-accordion pt-reveal">
      {%- for block in section.blocks -%}
        <div class="pt-accordion__item" {{ block.shopify_attributes }}>
          <h3>
            <button
              type="button"
              class="pt-accordion__trigger"
              data-accordion-trigger
              aria-expanded="false"
              aria-controls="FaqPanel-{{ section.id }}-{{ forloop.index }}"
              id="FaqTrigger-{{ section.id }}-{{ forloop.index }}">
              <span>{{ block.settings.question | escape }}</span>
              {% render 'icons', icon: 'chevron-down' %}
            </button>
          </h3>
          <div
            class="pt-accordion__panel"
            id="FaqPanel-{{ section.id }}-{{ forloop.index }}"
            role="region"
            aria-labelledby="FaqTrigger-{{ section.id }}-{{ forloop.index }}">
            <div class="pt-accordion__inner">
              <div class="pt-accordion__content">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Each piece is prepared to order. Most orders leave our atelier within 5\u20137 working days and arrive within 10\u201314 days across India.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
