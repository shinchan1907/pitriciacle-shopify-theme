{%- comment -%} Pitriciacle · Trade program — B2B intro + enquiry form (posts to /contact, tagged trade-enquiry) {%- endcomment -%}
<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="pt-trade__intro pt-text-center">
      {%- if section.settings.kicker != blank -%}
        <p class="pt-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="pt-h1">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="pt-lede pt-trade__lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pt-trade__props">
        {%- for block in section.blocks -%}
          <div class="pt-trade__prop" {{ block.shopify_attributes }}>
            <p class="pt-trade__prop-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <h3 class="pt-h3">{{ block.settings.title | escape }}</h3>
            <div class="pt-body pt-muted">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pt-trade__form-wrap">
      <h2 class="pt-h2 pt-text-center">{{ 'trade.form_heading' | t }}</h2>
      {% form 'contact', id: 'trade-form' %}
        {%- if form.posted_successfully? -%}
          <p class="mp__form-success" role="status">{% render 'icons', icon: 'check' %}<span>{{ 'trade.success' | t }}</span></p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="trade-enquiry">
          <div class="pt-form-grid">
            <div>
              <label class="pt-label" for="trade-studio">{{ 'trade.studio' | t }}</label>
              <input class="pt-input" type="text" id="trade-studio" name="contact[studio]" required autocomplete="organization">
            </div>
            <div>
              <label class="pt-label" for="trade-person">{{ 'trade.contact_person' | t }}</label>
              <input class="pt-input" type="text" id="trade-person" name="contact[name]" required autocomplete="name">
            </div>
            <div>
              <label class="pt-label" for="trade-email">{{ 'trade.email' | t }}</label>
              <input class="pt-input" type="email" id="trade-email" name="contact[email]" required autocomplete="email">
            </div>
            <div>
              <label class="pt-label" for="trade-phone">{{ 'trade.phone' | t }}</label>
              <input class="pt-input" type="tel" id="trade-phone" name="contact[phone]" autocomplete="tel">
            </div>
            <div>
              <label class="pt-label" for="trade-city">{{ 'trade.city' | t }}</label>
              <input class="pt-input" type="text" id="trade-city" name="contact[city]" autocomplete="address-level2">
            </div>
            <div>
              <label class="pt-label" for="trade-gstin">{{ 'trade.gstin' | t }}</label>
              <input class="pt-input" type="text" id="trade-gstin" name="contact[gstin]" inputmode="text">
            </div>
          </div>
          <label class="pt-label" for="trade-volume">{{ 'trade.volume' | t }}</label>
          <select class="pt-input" id="trade-volume" name="contact[volume]">
            <option value="{{ 'trade.volume_1' | t }}">{{ 'trade.volume_1' | t }}</option>
            <option value="{{ 'trade.volume_2' | t }}">{{ 'trade.volume_2' | t }}</option>
            <option value="{{ 'trade.volume_3' | t }}">{{ 'trade.volume_3' | t }}</option>
            <option value="{{ 'trade.volume_4' | t }}">{{ 'trade.volume_4' | t }}</option>
          </select>
          <label class="pt-label" for="trade-message">{{ 'trade.message' | t }}</label>
          <textarea class="pt-textarea" id="trade-message" name="contact[body]" rows="5"></textarea>
          <button type="submit" class="pt-btn pt-btn--full">{{ 'trade.send' | t }}</button>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trade program",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Trade program" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For designers & studios" },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>Pitriciacle works with interior designers, architects and hospitality studios across India and beyond — preferential pricing, dedicated support, and pieces reserved for your projects.</p>" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "porcelain", "label": "Porcelain" },
        { "value": "sand", "label": "Sand" },
        { "value": "sage", "label": "Sage" },
        { "value": "blush", "label": "Blush" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "porcelain"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 uses the theme default spacing." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 uses the theme default spacing." }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value proposition",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Preferential pricing" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Trade pricing on every collection, with volume tiers for larger projects.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade program",
      "blocks": [
        { "type": "prop", "settings": { "title": "Preferential pricing", "text": "<p>Trade pricing on every collection, with volume tiers for larger projects.</p>" } },
        { "type": "prop", "settings": { "title": "Reserved stock", "text": "<p>Pieces held for your project timelines, including made-to-order scheduling.</p>" } },
        { "type": "prop", "settings": { "title": "Dedicated support", "text": "<p>A single point of contact from specification to white-glove delivery.</p>" } }
      ]
    }
  ]
}
{% endschema %}
