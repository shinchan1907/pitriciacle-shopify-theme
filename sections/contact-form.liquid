<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container" style="max-width: 72rem;">
    {%- if section.settings.kicker != blank -%}
      <p class="pt-kicker pt-reveal">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h1 class="pt-h1 pt-reveal" style="margin-bottom: 1.6rem;">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="pt-body pt-muted pt-reveal" style="margin-bottom: 3.2rem;">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- form 'contact', class: 'pt-reveal' -%}
      {%- if form.posted_successfully? -%}
        <p class="pt-form-success" role="status">
          {% render 'icons', icon: 'check' %}
          {{ 'contact.form.success' | t }}
        </p>
      {%- endif -%}

      <div class="pt-field">
        <label class="pt-label" for="ContactForm-name-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
        <input
          type="text"
          id="ContactForm-name-{{ section.id }}"
          name="contact[name]"
          class="pt-input"
          value="{{ form.name }}"
          required
          autocomplete="name">
      </div>

      <div class="pt-field">
        <label class="pt-label" for="ContactForm-email-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
        <input
          type="email"
          id="ContactForm-email-{{ section.id }}"
          name="contact[email]"
          class="pt-input"
          value="{{ form.email }}"
          required
          autocomplete="email"
          aria-describedby="ContactForm-email-error-{{ section.id }}">
        {%- if form.errors contains 'email' -%}
          <p class="pt-form-error" id="ContactForm-email-error-{{ section.id }}" role="alert">{{ form.errors.messages.email }}</p>
        {%- endif -%}
      </div>

      <div class="pt-field">
        <label class="pt-label" for="ContactForm-phone-{{ section.id }}">{{ 'contact.form.phone' | t }}</label>
        <input
          type="tel"
          id="ContactForm-phone-{{ section.id }}"
          name="contact[phone]"
          class="pt-input"
          value="{{ form.phone }}"
          autocomplete="tel">
      </div>

      <div class="pt-field">
        <label class="pt-label" for="ContactForm-message-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
        <textarea
          id="ContactForm-message-{{ section.id }}"
          name="contact[body]"
          class="pt-textarea"
          rows="6"
          required>{{ form.body }}</textarea>
      </div>

      <button type="submit" class="pt-btn">{{ 'contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "We reply within two working days"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Write to us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Questions about a piece, a custom size, or a trade enquiry \u2014 the atelier desk reads everything."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
