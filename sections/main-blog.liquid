{%- comment -%} Pitriciacle · Main blog — article index with pagination {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .mb__head { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
  #shopify-section-{{ section.id }} .mb__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  #shopify-section-{{ section.id }} .mb__card { text-decoration: none; color: inherit; display: block; }
  #shopify-section-{{ section.id }} .mb__media { overflow: hidden; background: var(--pt-sand); aspect-ratio: 4 / 3; margin-bottom: 1.4rem; }
  #shopify-section-{{ section.id }} .mb__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s ease; }
  #shopify-section-{{ section.id }} .mb__card:hover .mb__media img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .mb__date { margin: 0 0 0.7rem; }
  #shopify-section-{{ section.id }} .mb__title { margin: 0 0 0.7rem; }
  #shopify-section-{{ section.id }} .mb__card:hover .mb__title { text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.25em; }
  #shopify-section-{{ section.id }} .mb__excerpt { margin: 0; }
  #shopify-section-{{ section.id }} .mb__pages { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin-top: 3.5rem; }
  #shopify-section-{{ section.id }} .mb__pages a, #shopify-section-{{ section.id }} .mb__pages span { min-width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; color: var(--pt-ink); border: 1px solid transparent; font-size: 0.95rem; padding: 0 0.5rem; }
  #shopify-section-{{ section.id }} .mb__pages a:hover { border-color: var(--pt-champagne); }
  #shopify-section-{{ section.id }} .mb__pages .is-current { border-color: var(--pt-ink); }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .mb__grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .mb__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    <div class="mb__head pt-reveal">
      <p class="pt-kicker">{{ 'blog.journal' | t }}</p>
      <h1 class="pt-h1">
        {%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- else -%}{{ blog.title | escape }}{%- endif -%}
      </h1>
    </div>

    {% paginate blog.articles by section.settings.posts_per_page %}
      <div class="mb__grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="mb__card pt-reveal" aria-label="Read: {{ article.title | escape }}">
            <span class="mb__media">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <img
                  src="{{ 'placeholder-lookbook-01.jpg' | asset_url }}"
                  alt="{{ article.title | escape }}"
                  loading="lazy"
                  decoding="async">
              {%- endif -%}
            </span>
            <p class="pt-kicker mb__date">{{ article.published_at | time_tag: '%B %d, %Y' }}</p>
            <h2 class="pt-h3 mb__title">{{ article.title | escape }}</h2>
            {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
              <p class="pt-body pt-muted mb__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="mb__pages" aria-label="{{ 'collection.pagination' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'collection.previous_page' | t }}">&larr; {{ 'collection.prev' | t }}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" aria-label="{{ 'collection.go_to_page' | t }} {{ part.title }}">{{ part.title }}</a>
            {%- elsif part.title == '&hellip;' -%}
              <span aria-hidden="true">{{ part.title }}</span>
            {%- else -%}
              <span class="is-current" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'collection.next_page' | t }}">{{ 'collection.next' | t }} &rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override (blank uses blog title)"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpts",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}
