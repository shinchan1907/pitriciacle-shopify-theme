{%- comment -%} Pitriciacle · Main cart — line items, quantities, summary {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .mcart__head { text-align: center; margin-bottom: 3rem; }
  #shopify-section-{{ section.id }} .mcart__layout { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
  #shopify-section-{{ section.id }} .mcart__item { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1.25rem; padding: 1.75rem 0; border-top: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .mcart__item:last-child { border-bottom: 1px solid rgba(138,129,120,0.35); }
  #shopify-section-{{ section.id }} .mcart__media { display: block; background: var(--pt-sand); aspect-ratio: 1; overflow: hidden; }
  #shopify-section-{{ section.id }} .mcart__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .mcart__title { font-family: var(--pt-serif); font-size: 1.3rem; margin: 0 0 0.35rem; }
  #shopify-section-{{ section.id }} .mcart__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .mcart__title a:hover { text-decoration: underline; text-decoration-color: var(--pt-champagne); text-underline-offset: 0.2em; }
  #shopify-section-{{ section.id }} .mcart__variant { margin: 0 0 0.35rem; font-size: 0.92rem; }
  #shopify-section-{{ section.id }} .mcart__props { margin: 0.35rem 0; padding: 0; list-style: none; font-size: 0.92rem; }
  #shopify-section-{{ section.id }} .mcart__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
  #shopify-section-{{ section.id }} .mcart__stepper { display: inline-flex; align-items: stretch; border: 1px solid rgba(43,38,32,0.25); }
  #shopify-section-{{ section.id }} .mcart__stepper button { width: 2.5rem; background: transparent; border: 0; cursor: pointer; color: var(--pt-ink); display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .mcart__stepper button svg { width: 0.85rem; height: 0.85rem; }
  #shopify-section-{{ section.id }} .mcart__stepper input { width: 3rem; border: 0; border-left: 1px solid rgba(43,38,32,0.18); border-right: 1px solid rgba(43,38,32,0.18); text-align: center; font-family: var(--pt-sans); font-size: 0.95rem; color: var(--pt-ink); background: transparent; -moz-appearance: textfield; }
  #shopify-section-{{ section.id }} .mcart__stepper input::-webkit-outer-spin-button, #shopify-section-{{ section.id }} .mcart__stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #shopify-section-{{ section.id }} .mcart__remove { font-size: 0.9rem; }
  #shopify-section-{{ section.id }} .mcart__linetotal { font-family: var(--pt-serif); font-size: 1.2rem; }
  #shopify-section-{{ section.id }} .mcart__summary { border: 1px solid rgba(138,129,120,0.4); padding: 2rem; background: var(--pt-porcelain); }
  #shopify-section-{{ section.id }} .mcart__sumrow { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
  #shopify-section-{{ section.id }} .mcart__total { border-top: 1px solid rgba(138,129,120,0.4); padding-top: 1.1rem; margin-top: 1.1rem; font-family: var(--pt-serif); font-size: 1.4rem; }
  #shopify-section-{{ section.id }} .mcart__checkout { width: 100%; margin-top: 1.5rem; }
  #shopify-section-{{ section.id }} .mcart__note { margin-top: 1rem; font-size: 0.88rem; text-align: center; }
  #shopify-section-{{ section.id }} .mcart__continue { display: block; text-align: center; margin-top: 1.25rem; }
  #shopify-section-{{ section.id }} .mcart__update { margin-top: 1.5rem; }
  #shopify-section-{{ section.id }} .mcart__empty { text-align: center; padding: 4rem 0; max-width: 52ch; margin: 0 auto; }
  #shopify-section-{{ section.id }} .mcart__empty h1 { margin: 1rem 0; }
  #shopify-section-{{ section.id }} .mcart__empty .pt-btn { margin-top: 1.75rem; }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .mcart__layout { grid-template-columns: 1fr 22rem; gap: 4rem; }
    #shopify-section-{{ section.id }} .mcart__summary { position: sticky; top: 6.5rem; }
    #shopify-section-{{ section.id }} .mcart__item { grid-template-columns: 8rem 1fr; }
  }
</style>

<div class="pt-section pt-scheme--{{ section.settings.color_scheme | default: 'porcelain' }}"{% if section.settings.padding_top > 0 or section.settings.padding_bottom > 0 %} style="{% if section.settings.padding_top > 0 %}--pt-pad-top: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom > 0 %}--pt-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}"{% endif %}>
  <div class="pt-container">
    {%- if cart.item_count > 0 -%}
      <div class="mcart__head">
        <p class="pt-kicker">{{ 'cart_page.title' | t }}</p>
        <h1 class="pt-h1">Your bag ({{ cart.item_count }})</h1>
      </div>

      <div class="mcart__layout">
        <div class="mcart__items">
          {% form 'cart', cart, id: 'mcart-form' %}
            {%- for item in cart.items -%}
              <div class="mcart__item">
                <a href="{{ item.url }}" class="mcart__media" aria-label="View {{ item.product.title | escape }}">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" loading="lazy" decoding="async">
                  {%- else -%}
                    <img src="{{ 'placeholder-product-metal-01.jpg' | asset_url }}" alt="{{ item.product.title | escape }}" loading="lazy" decoding="async">
                  {%- endif -%}
                </a>
                <div>
                  <h2 class="mcart__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="pt-muted mcart__variant">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}
                  {%- if item.properties.size > 0 -%}
                    <ul class="mcart__props pt-muted">
                      {%- for p in item.properties -%}
                        {%- unless p.last == blank -%}
                          <li>{{ p.first | escape }}: {{ p.last | escape }}</li>
                        {%- endunless -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  <p class="pt-muted mcart__variant">{{ item.price | money }} each</p>
                  <div class="mcart__row">
                    <div class="mcart__stepper">
                      <button type="button" data-mcart-btn="minus" data-mcart-line="{{ forloop.index }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icons', icon: 'minus' %}</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-mcart-qty aria-label="Quantity of {{ item.product.title | escape }}">
                      <button type="button" data-mcart-btn="plus" data-mcart-line="{{ forloop.index }}" aria-label="Increase quantity of {{ item.product.title | escape }}">{% render 'icons', icon: 'plus' %}</button>
                    </div>
                    <span class="mcart__linetotal">{{ item.final_line_price | money }}</span>
                  </div>
                  <div class="mcart__row">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="pt-btn--quiet mcart__remove">{{ 'general.cart.remove' | t }}</a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
            <button type="submit" name="update" class="pt-btn--outline mcart__update">{{ 'cart_page.update' | t }}</button>
          {% endform %}
        </div>

        <aside class="mcart__summary" aria-label="{{ 'cart_page.order_summary' | t }}">
          <h2 class="pt-h3">{{ 'cart_page.summary' | t }}</h2>
          <div class="mcart__sumrow">
            <span class="pt-muted">{{ 'cart_page.subtotal' | t }}</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="mcart__sumrow">
              <span class="pt-muted">{{ discount.title | escape }}</span>
              <span>&minus;{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="mcart__sumrow mcart__total">
            <span>{{ 'cart_page.total' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          {% form 'cart', cart %}
            <button type="submit" name="checkout" class="pt-btn mcart__checkout">{{ 'cart_page.checkout' | t }}</button>
          {% endform %}
          <p class="pt-muted mcart__note">{{ 'cart_page.taxes_note' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="pt-btn--quiet mcart__continue">{{ 'cart_page.continue_shopping' | t }}</a>
        </aside>
      </div>

      <script>
      (function () {
        var root = document.getElementById('shopify-section-{{ section.id }}');
        if (!root) return;
        var cartForm = document.getElementById('mcart-form');
        function submitCart() {
          if (!cartForm) return;
          if (typeof cartForm.requestSubmit === 'function') { cartForm.requestSubmit(); }
          else { cartForm.submit(); }
        }
        Array.prototype.forEach.call(root.querySelectorAll('[data-mcart-btn]'), function (btn) {
          btn.addEventListener('click', function () {
            var stepper = btn.closest('.mcart__stepper');
            var input = stepper ? stepper.querySelector('[data-mcart-qty]') : null;
            if (!input) return;
            var cur = parseInt(input.value, 10) || 0;
            if (btn.getAttribute('data-mcart-btn') === 'plus') { cur += 1; }
            else { cur = Math.max(0, cur - 1); }
            input.value = cur;
            submitCart();
          });
        });
      })();
      </script>
    {%- else -%}
      <div class="mcart__empty">
        <p class="pt-kicker">{{ 'cart_page.title' | t }}</p>
        <h1 class="pt-h1">{{ 'cart_page.empty_heading' | t }}</h1>
        <p class="pt-lede pt-muted">Beautiful rooms begin with a single object. Let us help you find yours.</p>
        <a href="{{ routes.all_products_collection_url }}" class="pt-btn">{{ 'cart_page.explore' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "porcelain",
          "label": "Porcelain"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Sage"
        },
        {
          "value": "blush",
          "label": "Blush"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "porcelain"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "0 uses the theme default spacing."
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
