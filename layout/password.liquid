<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#FAF8F4">
  <title>{{ shop.name }} &ndash; {{ 'password.heading' | t }}</title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
  <main id="MainContent" role="main" tabindex="-1">
    <div class="pt-password">
      <div class="pt-password__inner pt-reveal is-visible">
        <p class="pt-password__wordmark">{{ shop.name | escape }}</p>
        <p class="pt-kicker">{{ 'password.heading' | t }}</p>
        <p class="pt-lede" style="margin-top: 1.6rem;">{{ 'password.notify_text' | t }}</p>

        {% form 'customer', class: 'pt-password__form' %}
          {{ form.errors | default_errors }}
          {% if form.posted_successfully? %}
            <p class="pt-form-success">{{ 'password.success' | t }}</p>
          {% else %}
            <label class="pt-visually-hidden" for="password-email">{{ 'password.email_label' | t }}</label>
            <input
              type="email"
              id="password-email"
              name="contact[email]"
              class="pt-input"
              placeholder="{{ 'password.email_placeholder' | t }}"
              required
              autocomplete="email">
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <button type="submit" class="pt-btn">{{ 'password.button' | t }}</button>
          {% endif %}
        {% endform %}

        <hr class="pt-password__rule">

        {% form 'storefront_password', class: 'pt-password__form' %}
          {{ form.errors | default_errors }}
          <label class="pt-visually-hidden" for="password-code">{{ 'password.email_label' | t }}</label>
          <input
            type="password"
            id="password-code"
            name="password"
            class="pt-input"
            placeholder="••••••••"
            autocomplete="current-password"
            aria-label="{{ 'password.button' | t }}">
          <button type="submit" class="pt-btn pt-btn--outline">{{ 'password.button' | t }}</button>
        {% endform %}

        <p class="pt-password__fine">{{ powered_by_link }}</p>
      </div>
    </div>
  </main>
</body>
</html>
